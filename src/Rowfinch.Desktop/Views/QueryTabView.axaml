<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rowfinch.Desktop.ViewModels"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Rowfinch.Desktop.Views.QueryTabView" IsEnabled="{Binding !IsClosing}">
  <Grid RowDefinitions="*,34">
    <Grid Grid.Row="0" ColumnDefinitions="340,5,*">
      <Border Background="#141E1F" MinWidth="300">
        <TabControl x:Name="SidebarTabs" TabStripPlacement="Left" SelectedIndex="{Binding SidebarTabIndex, Mode=TwoWay}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent">
          <TabControl.Styles>
            <Style Selector="TabItem"><Setter Property="FontSize" Value="11" /><Setter Property="Width" Value="40" /><Setter Property="Padding" Value="10,14" /></Style>
          </TabControl.Styles>
          <TabItem x:Name="ConnectionsSidebarTab" AutomationProperties.Name="Connections" ToolTip.Tip="Connections">
            <TabItem.Header>
              <LayoutTransformControl>
                <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90" /></LayoutTransformControl.LayoutTransform>
                <TextBlock Text="Connections" />
              </LayoutTransformControl>
            </TabItem.Header>
            <Grid x:Name="ConnectionsPage" RowDefinitions="Auto,*,Auto,Auto" Margin="12,16,12,10" SizeChanged="OnConnectionsPageSizeChanged">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="CONNECTIONS" Classes="section" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ New" Command="{Binding NewProfileCommand}" Padding="8,4" />
              </Grid>
              <ListBox x:Name="ConnectionList" Grid.Row="1" Margin="0,12" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                       IsEnabled="{Binding CanEditConnection}" MinHeight="60" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="3" Margin="0,3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Database}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Expander x:Name="ConnectionDetails" Grid.Row="2" Header="Connection details" IsExpanded="{Binding ConnectionDetailsExpanded, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxHeight="560">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="12" Margin="0,8,0,0">
                    <StackPanel Spacing="9" IsEnabled="{Binding CanEditConnection}">
                      <TextBox Text="{Binding ProfileName, Mode=TwoWay}" PlaceholderText="Connection name" />
                      <TextBlock Text="Server" Classes="muted" FontSize="11" />
                      <TextBox Text="{Binding Server, Mode=TwoWay}" PlaceholderText="your-server.database.windows.net" />
                      <TextBlock Text="Database" Classes="muted" FontSize="11" />
                      <TextBox Text="{Binding Database, Mode=TwoWay}" PlaceholderText="Database name" />
                      <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedIndex="{Binding AuthenticationIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" />
                      <TextBox Text="{Binding UserName, Mode=TwoWay}" PlaceholderText="User name / optional Entra sign-in hint" FontSize="12" />
                      <TextBox x:Name="PasswordInput" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{Binding PasswordPlaceholder}" IsVisible="{Binding IsSqlAuthentication}" />
                      <CheckBox x:Name="RememberPasswordCheckBox" Content="Remember password" IsChecked="{Binding RememberPassword, Mode=TwoWay}" IsVisible="{Binding IsSqlAuthentication}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,8,*">
                      <Button Content="Save profile" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Stretch" />
                      <Button Grid.Column="2" Content="Try demo" Command="{Binding DemoCommand}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Spacing="7" IsVisible="{Binding IsSqlAuthentication}">
                      <TextBlock x:Name="KeyringStatus" Text="{Binding KeyringMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      <Button x:Name="ForgetPasswordButton" Content="Forget saved password" Command="{Binding ForgetPasswordCommand}" HorizontalAlignment="Stretch" FontSize="12" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Expander>
              <Grid Grid.Row="3" ColumnDefinitions="*,8,*" Margin="0,10,0,0">
                <Button Content="Connect" Classes="primary" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Content="Disconnect" Click="OnDisconnect" IsEnabled="{Binding CanExecute}" HorizontalAlignment="Stretch" />
              </Grid>
            </Grid>
          </TabItem>
          <TabItem x:Name="ObjectsSidebarTab" AutomationProperties.Name="Objects" ToolTip.Tip="Objects">
            <TabItem.Header>
              <LayoutTransformControl>
                <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90" /></LayoutTransformControl.LayoutTransform>
                <TextBlock Text="Objects" />
              </LayoutTransformControl>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="12,16,12,10" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="DATABASE OBJECTS" Classes="section" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshObjectsCommand}" Padding="7,4" FontSize="11" />
              </Grid>
              <TextBox x:Name="ObjectFilterInput" Grid.Row="1" Text="{Binding ObjectFilter, Mode=TwoWay}" PlaceholderText="Filter objects…" />
              <WrapPanel Grid.Row="2" ItemSpacing="8">
                <RadioButton x:Name="AllTypesFilter" Content="All" IsChecked="{Binding AllObjectTypes, Mode=TwoWay}" FontSize="11" MinHeight="26" />
                <CheckBox x:Name="TablesTypeFilter" Content="Tables" IsChecked="{Binding ShowTables, Mode=TwoWay}" FontSize="11" MinHeight="26" />
                <CheckBox x:Name="ViewsTypeFilter" Content="Views" IsChecked="{Binding ShowViews, Mode=TwoWay}" FontSize="11" MinHeight="26" />
                <CheckBox Content="Procedures" IsChecked="{Binding ShowProcedures, Mode=TwoWay}" FontSize="11" MinHeight="26" />
                <CheckBox Content="Functions" IsChecked="{Binding ShowFunctions, Mode=TwoWay}" FontSize="11" MinHeight="26" />
              </WrapPanel>
              <TextBlock Grid.Row="3" Text="Expand an object and check columns. Right-click to generate SQL." Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TreeView x:Name="ObjectTree" Grid.Row="4" ItemsSource="{Binding Objects}" Background="Transparent" Padding="0" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanExecute}">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate DataType="vm:ObjectBrowserNode" ItemsSource="{Binding Children}">
                    <Grid Background="Transparent" ContextRequested="OnObjectContextRequested" DoubleTapped="OnObjectDoubleTapped" Margin="0,4"
                          ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <CheckBox IsVisible="{Binding IsSelectableColumn}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinWidth="0" MinHeight="22" Margin="0,0,6,0" Padding="0" VerticalAlignment="Top" ToolTip.Tip="Include this column in generated SQL" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding HasColumnActions}" Spacing="5" Margin="0,6,0,2">
                        <TextBlock Text="{Binding SelectionSummary}" Classes="muted" FontSize="10" />
                        <WrapPanel ItemSpacing="5">
                          <Button Content="Select all" Command="{Binding SelectAllColumnsCommand}" FontSize="10" Padding="5,3" />
                          <Button Content="Unselect all" Command="{Binding UnselectAllColumnsCommand}" FontSize="10" Padding="5,3" />
                        </WrapPanel>
                      </StackPanel>
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <TextBlock Grid.Row="5" Text="{Binding ObjectCountLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="1" Background="#233331" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,5,*,Auto" Margin="20,16,20,12">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Query workspace" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Write SQL. Explore your data." Classes="muted" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Button Content="Open SQL…" Click="OnOpenSql" />
            <Button Content="Save SQL…" Click="OnSaveSql" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#20382F" BorderBrush="#426854" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" IsVisible="{Binding IsDemo}">
          <TextBlock Text="DEMO  ·  Sample results only. Editor text is not sent to a database." Foreground="#B9E3CB" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" BorderBrush="#2A3B39" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
          <Grid RowDefinitions="44,Auto,*">
            <Border Background="#1B2828" Padding="12,0">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentLabel}" VerticalAlignment="Center" Foreground="#B7E4CF" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="▶  Run" Classes="primary" Click="OnRun" IsEnabled="{Binding CanExecute}" Padding="14,5" ToolTip.Tip="Run selection or document (Ctrl+Enter / F5)" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="12,8" ColumnSpacing="8">
              <TextBlock Text="Display rows" Classes="muted" VerticalAlignment="Center" FontSize="11" />
              <NumericUpDown Grid.Column="1" Value="{Binding RowLimit, Mode=TwoWay}" Minimum="1" Maximum="100000" Increment="100" Width="140" FormatString="0" IsEnabled="{Binding !IsBusy}" />
              <TextBlock Grid.Column="2" Text="Timeout (s)" Classes="muted" VerticalAlignment="Center" FontSize="11" />
              <NumericUpDown Grid.Column="3" Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" Width="125" FormatString="0" IsEnabled="{Binding !IsBusy}" />
              <TextBlock Grid.Column="4" Text="T-SQL  ·  GO batches" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
            </Grid>
            <editor:TextEditor x:Name="SqlEditor" Grid.Row="2" FontFamily="DejaVu Sans Mono,monospace" FontSize="13"
                               Background="#111A1D" Foreground="#DBE6E4" ShowLineNumbers="True" Padding="10"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
          </Grid>
        </Border>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />

        <Border Grid.Row="4" BorderBrush="#2A3B39" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
          <TabControl x:Name="OutputTabs" SelectedIndex="{Binding OutputTabIndex, Mode=TwoWay}" Background="#111A1D">
            <TabItem Header="Results">
              <Grid RowDefinitions="44,*">
                <Grid ColumnDefinitions="180,*,Auto" Margin="10,5">
                  <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" Classes="muted" VerticalAlignment="Center" Margin="12,0" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <Button x:Name="ExportResultButton" Grid.Column="2" Content="Export…" IsEnabled="{Binding CanExportResult}">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="Rows as CSV…" Click="OnExportCsv" />
                        <MenuItem Header="Rows as JSON…" Click="OnExportJson" />
                        <Separator />
                        <MenuItem Header="C# class with annotations…" Click="OnGenerateCSharp" />
                        <MenuItem Header="JSON object…" Click="OnGenerateJsonObject" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <TableView x:Name="ResultsTable" Grid.Row="1" CanUserResizeColumns="True" SelectionMode="Multiple,Toggle" Background="Transparent">
                  <TableView.ContextMenu><ContextMenu><MenuItem Header="Copy selected rows" Click="OnCopyRows" /></ContextMenu></TableView.ContextMenu>
                </TableView>
              </Grid>
            </TabItem>
            <TabItem Header="Messages">
              <TextBox Text="{Binding Messages, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="DejaVu Sans Mono,monospace" FontSize="12" Background="Transparent" BorderThickness="0" Margin="10"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>
          </TabControl>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0" ColumnSpacing="8">
          <TextBlock Text="{Binding TransactionLabel}" Classes="muted" VerticalAlignment="Center" FontSize="11" />
          <Button Grid.Column="1" Content="Commit" Command="{Binding CommitCommand}" Padding="10,5" />
          <Button Grid.Column="2" Content="Rollback" Command="{Binding RollbackCommand}" Padding="10,5" />
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="#1A2825" BorderBrush="#2A3B39" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" Foreground="#B4D9C8" FontSize="11" />
        <TextBlock Grid.Column="1" Text="Ctrl+Enter  Run   ·   Ctrl+O  Open   ·   Ctrl+S  Save" Classes="muted" FontSize="11" />
      </Grid>
    </Border>
    <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Foreground="#79CFB0" />
  </Grid>
</UserControl>
