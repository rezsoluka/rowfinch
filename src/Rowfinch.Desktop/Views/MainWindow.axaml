<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Rowfinch.Desktop"
        x:Class="Rowfinch.Desktop.Views.MainWindow"
        Title="Rowfinch — Your SQL workspace" Icon="avares://Rowfinch/Assets/rowfinch.png" Width="1380" Height="960"
        MinWidth="1050" MinHeight="780" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="72,Auto,*">
    <Border Grid.Row="0" Background="#162121" BorderBrush="#2A3B39" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#79CFB0" CornerRadius="10" Width="38" Height="38">
            <TextBlock Text="r" Foreground="#102820" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Rowfinch" FontSize="20" FontWeight="SemiBold" />
              <Border Background="#20332E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static app:AppVersion.BuildDetails}">
                <TextBlock x:Name="AppVersionText" Text="{x:Static app:AppVersion.DisplayVersion}"
                           FontSize="11" Foreground="#ADE1CC" MaxWidth="160" TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>
            <TextBlock Text="YOUR SQL WORKSPACE" Classes="section" FontSize="9" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Azure SQL / SQL Server" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#20332E" CornerRadius="6" Padding="12,7" VerticalAlignment="Center" MaxWidth="380">
            <TextBlock Text="{Binding SelectedTab.ConnectionLabel}" TextTrimming="CharacterEllipsis" Foreground="#ADE1CC" />
          </Border>
          <Button x:Name="OpenAssistantButton" Content="Assistant" Click="OnAssistant" IsEnabled="{Binding CanManageTabs}" />
          <Button x:Name="SafetyPrivacyButton" Content="About / Privacy" Click="OnSafetyPrivacy" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#111B1C" BorderBrush="#2A3B39" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ListBox x:Name="QueryTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 Background="Transparent" Padding="0" BorderThickness="0" IsEnabled="{Binding CanManageTabs}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Width="205" ColumnSpacing="8" Margin="2,0">
                <StackPanel Spacing="3" VerticalAlignment="Center" ToolTip.Tip="{Binding ConnectionLabel}">
                  <TextBlock Text="{Binding DocumentLabel}" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="●" Foreground="#79CFB0" FontSize="9" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding SessionLabel}" Classes="muted" FontSize="10" MaxWidth="145" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="OnCloseTab" Padding="6,1" FontSize="17"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="Close query tab" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="1" Content="+ New query" Command="{Binding NewTabCommand}" VerticalAlignment="Center" ToolTip.Tip="New query tab (Ctrl+T)" />
      </Grid>
    </Border>
    <ContentControl x:Name="QueryHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
