<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Rowfinch.Desktop.Views.ResultModelDialog"
        Title="Generate from SELECT results" Width="800" Height="680" MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="12">
    <TextBlock Text="Generate from the selected result set" FontSize="19" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="ResultDescription" Classes="muted" TextWrapping="Wrap" />
      <ComboBox x:Name="ModelFormat" SelectedIndex="0" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="C# class with data annotations" />
        <ComboBoxItem Content="JSON object" />
      </ComboBox>
      <Grid x:Name="ClassNameRow" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="Class name" VerticalAlignment="Center" />
        <TextBox x:Name="ClassNameInput" Grid.Column="1" Text="QueryResult" />
      </Grid>
      <CheckBox x:Name="UseFirstRow" Content="Use values from the first displayed row" IsChecked="True" IsVisible="False" />
      <TextBlock x:Name="GenerationHint" Classes="muted" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
    <TextBox x:Name="GeneratedText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="DejaVu Sans Mono,monospace" FontSize="12"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <TextBlock x:Name="GenerationStatus" Grid.Row="3" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Close" Click="OnClose" />
      <Button Content="Copy" Click="OnCopy" />
      <Button Content="Save…" Click="OnSave" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
